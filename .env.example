# BoxBox environment configuration
# Copy this file to .env and customize it before deploying.

# ===========================================
# Security Settings (CHANGE THESE!)
# ===========================================

# JWT secret for authentication. Use a long random string.
# Generate with: openssl rand -base64 32
FM_JWT_SECRET=change-me-in-production-use-a-long-random-string

# Admin password. Additional users can be added as FM_USERS_<username>.
FM_USERS_admin=change-me-in-production

# ===========================================
# Deployment Settings
# ===========================================

# Host port published by docker-compose.yml.
HOST_PORT=8080

# Container image used by docker-compose.yml.
BOXBOX_IMAGE=ghcr.io/jr4dh3y/boxbox:latest

# Optional: override the server port inside the container.
# The Dockerfile exposes port 80 by default.
# FM_PORT=80

# ===========================================
# Rate Limiting
# ===========================================

# Auth endpoint rate limit (requests per second per IP)
# Set to 0 to disable rate limiting
FM_RATE_LIMIT_RPS=10

# ===========================================
# CORS / WebSocket Origins
# ===========================================

# Allowed origins for WebSocket connections
# Leave empty to allow all origins (homelab mode)
# Format: comma-separated list
# Supports wildcards: *.example.com
# Example: FM_ALLOWED_ORIGINS=http://localhost:8080,https://files.example.com
FM_ALLOWED_ORIGINS=

# ===========================================
# Mount Settings
# ===========================================

# Host home directory to expose as /home/user in the container.
# Leave unset to use the HOME of the user running docker compose.
# HOME_PATH=/home/your-user

# Optional quick-access folder overrides.
# By default docker-compose maps these to HOME_PATH/Desktop, HOME_PATH/Downloads, etc.
# If HOME_PATH is unset, it uses $HOME/Desktop, $HOME/Downloads, etc.
# Uncomment any line to point that sidebar shortcut at a custom host path.
# DESKTOP_PATH=/home/your-user/Desktop
# DOWNLOADS_PATH=/home/your-user/Downloads
# DOCUMENTS_PATH=/home/your-user/Documents
# MUSIC_PATH=/home/your-user/Music
# PICTURES_PATH=/home/your-user/Pictures
# VIDEOS_PATH=/home/your-user/Videos

# ===========================================
# Optional: User/Group ID Mapping
# ===========================================
# If you need specific UID/GID for file permissions
# Uncomment and set these values

# PUID=1000
# PGID=1000

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showDotGrid?: boolean;
}

const { title, description = "Fast, lightweight file manager for Linux servers.", showDotGrid = true } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#0d0d0d]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/logo-boxbox-3d.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Caveat:wght@700&display=swap" rel="stylesheet">
    <slot name="head" />
  </head>
  <body class="relative flex min-h-screen flex-col bg-[#07080b] text-text-primary antialiased">
    <div class="page-curtain relative z-20 flex flex-1 flex-col bg-[#0d0d0d]">
      <!-- Interactive Bayer-dithered dot grid behind the top of the page, fading out cleanly. -->
      {showDotGrid && (
        <div
          data-dot-grid-root
          class="dot-grid pointer-events-none absolute inset-x-0 top-0 z-0 h-[900px]"
          aria-hidden="true"
        >
          <canvas data-dot-grid class="block h-full w-full"></canvas>
        </div>
      )}

      <slot />
    </div>

    <slot name="footer" />

    <script>
      import { mountInteractiveDotGrid } from '../lib/interactiveDotGrid';

      document.querySelectorAll<HTMLElement>('[data-dot-grid-root]').forEach((root) => {
        mountInteractiveDotGrid(root);
      });
    </script>
  </body>
</html>

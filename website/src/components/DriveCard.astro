---
import { Server } from '@lucide/astro';

export interface Props {
  path: string;
  total: string;
  used: string;
  free: string;
  device: string;
  fs: string;
  percent: number;
  color: string;
}

const { path, total, used, free, device, fs, percent, color } = Astro.props;
---

<button type="button" data-action="go" data-path={path} class="group flex w-full items-center gap-4 rounded-xl border border-border-primary bg-surface-secondary/82 p-4 text-left backdrop-blur-sm transition-colors hover:border-border-focus/60">
  <div class="flex h-[84px] w-[84px] shrink-0 items-center justify-center rounded-lg bg-surface-elevated/85 text-text-secondary transition-colors group-hover:text-[#e0e0e0]">
    <Server class="h-7 w-7" />
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-center">
    <div class="mb-1 flex items-center justify-between gap-2">
      <span class="truncate text-[14px] font-medium tracking-wide text-[#e0e0e0]">{path}</span>
      <span class="rounded bg-surface-elevated/85 px-2 py-0.5 text-[11px] text-text-secondary">{total}</span>
    </div>
    <div class="mb-1 text-[12px] text-[#888888]">{used} used &middot; {free} free</div>
    <div class="mb-3 truncate font-mono text-[11px] text-text-muted">
      {device} &middot; {fs}
    </div>
    <div class="flex items-center gap-3">
      <div class="h-[3px] flex-1 overflow-hidden rounded-full bg-[#333333]">
        <div class="h-full rounded-full transition-[background-color,width] duration-700 ease-out" style={`background-color: ${color}; width: ${percent}%`}></div>
      </div>
      <span class="shrink-0 text-[11px] transition-colors duration-700 ease-out" style={`color: ${color}`}>{percent}%</span>
    </div>
  </div>
</button>

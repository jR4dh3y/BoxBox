---
// The commands are the quick start from docs/quickstart.md.
import { ArrowRight } from '@lucide/astro';

const commands = `mkdir -p boxbox
cd boxbox

curl -fsSLO https://raw.githubusercontent.com/jR4dh3y/BoxBox/master/docker-compose.yml
curl -fsSLO https://raw.githubusercontent.com/jR4dh3y/BoxBox/master/.env.example
mkdir -p backend
curl -fsSL https://raw.githubusercontent.com/jR4dh3y/BoxBox/master/backend/config.yaml -o backend/config.yaml

cp .env.example .env
$EDITOR .env

docker compose pull
docker compose up -d`;
---

<section class="relative z-10 border-t border-white/5 bg-[#0d0d0d] px-5 py-20 md:px-8 md:py-28">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-white md:text-4xl">How to run it</h2>
      <p class="mt-6 max-w-md leading-relaxed text-text-secondary">
        Docker Compose pulls the published image, so there is no source checkout. Set your secrets in <code class="text-text-primary" style="font-family: 'JetBrains Mono', monospace; font-size: 0.9em;">.env</code>, then open <code class="text-text-primary" style="font-family: 'JetBrains Mono', monospace; font-size: 0.9em;">localhost:8080</code>.
      </p>
      <a href="/docs/quickstart/" class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-lg bg-accent-solid px-6 font-semibold text-white transition-colors hover:bg-accent-solid-hover">
        Read the quick start <ArrowRight class="h-5 w-5" aria-hidden="true" />
      </a>
      <p id="desktop" class="mt-10 max-w-md scroll-mt-10 border-t border-border-primary pt-6 leading-relaxed text-text-secondary">
        Prefer an app? BoxBox Desktop for Linux browses local files without a server, or pairs with the one you host.{' '}
        <a href="/download/#desktop" class="font-semibold text-accent hover:underline">Download for Linux</a>
      </p>
    </div>

    <div class="min-w-0 overflow-hidden rounded-[14px] border border-border-secondary bg-[#111]">
      <div class="flex h-11 items-center justify-between border-b border-border-secondary pl-4 pr-1.5 text-[13px] text-text-secondary">
        <span style="font-family: 'JetBrains Mono', monospace;">zsh — ~/boxbox</span>
        <button type="button" id="quickstart-copy" class="h-8 rounded px-3 font-medium text-text-primary transition-colors hover:bg-surface-elevated">Copy</button>
      </div>
      <pre id="quickstart-commands" class="mock-scrollbar overflow-x-auto p-5 text-[13px] leading-7 text-text-primary" style="font-family: 'JetBrains Mono', monospace;">{commands}</pre>
    </div>
  </div>
</section>

<script>
  const copyButton = document.getElementById('quickstart-copy');
  const commandBlock = document.getElementById('quickstart-commands');

  if (copyButton && commandBlock) {
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(commandBlock.textContent ?? '');
        copyButton.textContent = 'Copied';
      } catch {
        copyButton.textContent = 'Select and copy';
      }
      window.setTimeout(() => { copyButton.textContent = 'Copy'; }, 2000);
    });
  }
</script>

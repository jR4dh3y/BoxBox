---
import { ArrowUpRight } from '@lucide/astro';
import Wordmark from './Wordmark.astro';

interface Link {
  label: string;
  href: string;
  external?: boolean;
}

const columns: { title: string; links: Link[] }[] = [
  {
    title: 'Get it',
    links: [
      { label: 'Download', href: '/download/' },
      { label: 'Linux desktop', href: '/docs/desktop/' },
      { label: 'Quickstart', href: '/docs/quickstart/' },
      { label: 'Release notes', href: '/docs/release/' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Overview', href: '/docs/' },
      { label: 'Configuration', href: '/docs/configuration/' },
      { label: 'API reference', href: '/docs/api/' },
      { label: 'Troubleshooting', href: '/docs/troubleshooting/' },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'GitHub', href: 'https://github.com/jR4dh3y/BoxBox', external: true },
      { label: 'Releases', href: 'https://github.com/jR4dh3y/BoxBox/releases', external: true },
      { label: 'Report an issue', href: 'https://github.com/jR4dh3y/BoxBox/issues', external: true },
    ],
  },
];

const projects = [
  { name: 'fbs-core', href: 'https://fbs-landing.vercel.app/', about: 'S3-compatible blob storage and CDN' },
  { name: 'qckpages', href: 'https://qckpage.jr4.in/', about: 'Publish HTML files as pages in seconds' },
  { name: 'vigil-owl', href: 'https://vigil-owl.vercel.app/', about: 'Self-hosted NVR with timeline playback' },
];
---

<footer class="relative z-10 border-t border-border-primary bg-surface-primary">
  <div class="mx-auto max-w-7xl px-5 pt-12 pb-8 md:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <Wordmark id="footer-logo" class="h-8 w-auto" />
        <p class="mt-3 max-w-64 text-sm leading-relaxed text-text-muted">Self-hosted, fast, and free. Your files stay where they are.</p>
      </div>

      {columns.map((column) => (
        <div class="text-sm">
          <h3 class="mb-3 text-text-muted">{column.title}</h3>
          <ul class="space-y-2 text-text-primary">
            {column.links.map((link) => (
              <li>
                <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} class="transition-colors hover:text-white">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <ul aria-label="More projects" class="mt-12 grid divide-y divide-border-secondary rounded-lg border border-border-secondary sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {projects.map((project) => (
        <li>
          <a href={project.href} target="_blank" rel="noopener" class="group block h-full px-5 py-4 transition-colors hover:bg-surface-secondary">
            <span class="flex items-center gap-1 font-medium text-text-primary group-hover:text-white">
              {project.name}
              <ArrowUpRight class="h-3.5 w-3.5 text-text-muted" aria-hidden="true" />
            </span>
            <span class="mt-1 block text-xs text-text-muted">{project.about}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-[13px] text-text-muted">
      <span>MIT licensed</span>
      <span class="flex gap-5">
        <a href="/privacy/" class="transition-colors hover:text-white">Privacy</a>
        <a href="/terms/" class="transition-colors hover:text-white">Terms</a>
        <a href="/security/" class="transition-colors hover:text-white">Security</a>
        <a href="https://github.com/jR4dh3y" target="_blank" rel="noopener" class="transition-colors hover:text-white">jR4dh3y</a>
      </span>
    </div>
  </div>
</footer>

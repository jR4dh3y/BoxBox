---
// One beat of the tour: a real screenshot with a phrase in the promo video's
// voice set over its lower edge.
interface Props {
  id?: string;
  src: string;
  alt: string;
  width: number;
  height: number;
  lead: string;
  accent: string;
  size?: 'wide' | 'half';
  tilt?: 'left' | 'right';
}

const { id, src, alt, width, height, lead, accent, size = 'half', tilt = 'left' } = Astro.props;
---

<figure id={id} class:list={['scene', `scene-${size}`, `scene-tilt-${tilt}`, 'scroll-mt-10']}>
  <div class="scene-shot">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption class="scene-caption">
    <h2 class="scene-phrase font-display">{lead} <span class="text-accent">{accent}</span></h2>
    <div class="scene-body"><slot /></div>
  </figcaption>
</figure>

<style>
  .scene { margin: 0; }

  .scene-shot { perspective: 1800px; }

  .scene-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-secondary);
    border-radius: 14px;
    background: #161616;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
    transform-origin: center bottom;
  }

  .scene-caption {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 0 0.25rem;
  }

  .scene-phrase {
    margin-top: -0.62em;
    font-size: clamp(2.5rem, 6.2vw, 4.25rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 2px 28px #0d0d0d, 0 0 6px rgb(13 13 13 / 0.9);
    text-wrap: balance;
  }

  .scene-wide .scene-phrase { font-size: clamp(2.75rem, 8.6vw, 6.5rem); }

  .scene-body {
    max-width: 34rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .scene-caption { padding: 0 2rem; }

    .scene-wide .scene-caption {
      grid-template-columns: 1fr minmax(0, 26rem);
      align-items: end;
      gap: 3rem;
      padding: 0 3.5rem;
    }

    .scene-wide .scene-body { padding-bottom: 0.6rem; }
  }

  /* Each screenshot arrives tilted, as in the promo, and settles flat as it
     scrolls into place. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .scene-shot img {
        animation: scene-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 42%;
      }

      .scene-tilt-left { --scene-tilt: 9deg; }
      .scene-tilt-right { --scene-tilt: -9deg; }
    }
  }

  @keyframes scene-settle {
    from {
      opacity: 0.35;
      transform: rotateX(16deg) rotateY(var(--scene-tilt, 0deg)) scale(0.88);
    }
  }
</style>

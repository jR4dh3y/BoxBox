---
// Real screenshots, opened the way BoxBox opens an image: in a preview
// dialog with previous and next.
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';

const shots = [
  { file: 'browse', width: 1600, height: 1000, span: 'md:col-span-7', caption: 'Browse drives and places', alt: 'BoxBox browsing a Pictures folder in grid view, with drives and places in the sidebar' },
  { file: 'editor', width: 1340, height: 908, span: 'md:col-span-5', caption: 'Edit configs in the browser', alt: 'docker-compose.yml open in the BoxBox code editor' },
  { file: 'preview', width: 1340, height: 908, span: 'md:col-span-4', caption: 'Preview without downloading', alt: 'sunset.jpg open in the BoxBox image preview' },
  { file: 'share-modal', width: 1000, height: 678, span: 'md:col-span-4', caption: 'Create share links per file or folder', alt: 'Share dialog for a folder, with access level and expiry' },
  { file: 'share-page', width: 1600, height: 1000, span: 'md:col-span-4', caption: 'Recipients browse, preview, and download without an account', alt: 'Public share page showing a shared folder with an image preview' }
];
---

<section id="features" class="relative z-10 scroll-mt-8 border-t border-white/5 bg-[#0d0d0d] px-5 py-20 md:px-8 md:py-28">
  <div class="mx-auto max-w-7xl">
    <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-white md:text-4xl">What it looks like</h2>

    <div class="mt-8 grid gap-x-4 gap-y-8 md:grid-cols-12">
      {shots.map((shot, index) => (
        <figure class:list={['flex flex-col', shot.span]}>
          <button
            type="button"
            data-shot={index}
            data-src={`/media/screens/${shot.file}.webp`}
            data-caption={shot.caption}
            aria-label={`Enlarge screenshot: ${shot.caption}`}
            class:list={['shot relative block w-full flex-1 overflow-hidden rounded-[10px] border border-border-secondary bg-[#161616]', index === 0 ? 'md:aspect-[16/10]' : index > 1 && 'md:aspect-[3/2]']}
          >
            <img src={`/media/screens/${shot.file}.webp`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" class="block h-auto w-full object-cover object-left-top md:absolute md:inset-0 md:h-full" />
          </button>
          <figcaption class="mt-3 text-sm text-text-secondary">{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <dialog id="shot-viewer" aria-labelledby="shot-viewer-title" class="shot-viewer">
    <div class="flex h-12 items-center gap-1 border-b border-border-secondary pl-4 pr-2 text-[13px]">
      <p id="shot-viewer-title" class="flex-1 truncate font-medium text-text-primary"></p>
      <button type="button" id="shot-viewer-prev" aria-label="Previous screenshot" class="shot-viewer-button"><ChevronLeft class="h-[18px] w-[18px]" /></button>
      <button type="button" id="shot-viewer-next" aria-label="Next screenshot" class="shot-viewer-button"><ChevronRight class="h-[18px] w-[18px]" /></button>
      <button type="button" id="shot-viewer-close" aria-label="Close" class="shot-viewer-button"><X class="h-[18px] w-[18px]" /></button>
    </div>
    <img id="shot-viewer-image" alt="" class="block max-h-[calc(100vh-7rem)] w-full object-contain" />
  </dialog>
</section>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('#shot-viewer');
  const image = document.querySelector<HTMLImageElement>('#shot-viewer-image');
  const title = document.getElementById('shot-viewer-title');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-shot]'));

  if (viewer && image && title && thumbs.length > 0) {
    let current = 0;

    function show(index: number) {
      current = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[current];
      image.src = thumb.dataset.src ?? '';
      image.alt = thumb.querySelector('img')?.alt ?? '';
      title.textContent = thumb.dataset.caption ?? '';
    }

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        show(index);
        viewer.showModal();
      });
    });

    document.getElementById('shot-viewer-prev')?.addEventListener('click', () => show(current - 1));
    document.getElementById('shot-viewer-next')?.addEventListener('click', () => show(current + 1));
    document.getElementById('shot-viewer-close')?.addEventListener('click', () => viewer.close());

    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

<style>
  .shot {
    cursor: zoom-in;
    transition: border-color 200ms ease;
  }

  .shot img { transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1); }

  .shot:hover { border-color: var(--color-accent); }
  .shot:hover img { transform: scale(1.025); }

  .shot-viewer {
    width: min(1280px, calc(100vw - 2rem));
    max-width: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-primary);
    border-radius: 10px;
    background: var(--color-surface-primary);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.9);
  }

  .shot-viewer::backdrop {
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }

  .shot-viewer-button {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    color: var(--color-text-secondary);
  }

  .shot-viewer-button:hover {
    background: var(--color-surface-elevated);
    color: var(--color-text-primary);
  }
</style>

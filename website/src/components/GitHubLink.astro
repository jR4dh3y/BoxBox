---
import { Star } from '@lucide/astro';
---

<a href="https://github.com/jR4dh3y/BoxBox" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded px-3 transition-colors hover:text-white">
  GitHub
  <span data-github-stars hidden class="inline-flex items-center gap-1 tabular-nums"><Star class="h-3.5 w-3.5" aria-hidden="true" /><span data-github-stars-count></span><span class="sr-only"> stars</span></span>
</a>

<script>
  import { formatCount, parseCountPayload } from '../lib/counts';

  // The link reads "GitHub" alone until the star count is known.
  const stars = document.querySelector<HTMLElement>('[data-github-stars]');
  const count = document.querySelector<HTMLElement>('[data-github-stars-count]');
  if (stars && count) {
    fetch('/api/stars.json')
      .then((response) => (response.ok ? response.json() : null))
      .then((payload: unknown) => {
        const total = parseCountPayload(payload);
        if (total === null) return;
        count.textContent = formatCount(total);
        stars.hidden = false;
      })
      .catch(() => undefined);
  }
</script>

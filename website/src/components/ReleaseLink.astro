---
// The latest release, as a "What's new" link in the nav. It reads the
// server-side cached endpoint so page views do not spend the GitHub API's
// unauthenticated limit, and stays hidden until it knows the version. Phones
// leave it out so the nav fits on one row.
---

<a
  id="release-link"
  href="https://github.com/jR4dh3y/BoxBox/releases"
  target="_blank"
  rel="noopener"
  hidden
  class="hidden min-h-11 shrink-0 sm:inline-flex items-center px-3 whitespace-nowrap text-text-primary transition-colors hover:text-white"
>
  <span class="underline decoration-accent decoration-[1.5px] underline-offset-[6px]">What’s new in <span id="release-link-version"></span></span>
</a>

<script>
  const link = document.querySelector<HTMLAnchorElement>('#release-link');
  const version = document.getElementById('release-link-version');

  if (link && version) {
    fetch('/api/releases.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((release) => {
        if (!release || typeof release.tagName !== 'string' || release.tagName === '') return;
        if (typeof release.htmlUrl === 'string' && /^https:\/\/github\.com\/jR4dh3y\/BoxBox\/releases\/tag\/v[\w.-]+$/.test(release.htmlUrl)) link.href = release.htmlUrl;
        version.textContent = release.tagName;
        link.hidden = false;
      })
      .catch(() => {
        // No release info; the link stays hidden.
      });
  }
</script>

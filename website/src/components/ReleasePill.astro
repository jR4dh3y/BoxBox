---
// The latest release, as a pill in the nav. It reads the server-side cached
// endpoint so page views do not spend the GitHub API's unauthenticated limit,
// and stays hidden until it knows the version.
---

<a
  id="release-pill"
  href="https://github.com/jR4dh3y/BoxBox/releases"
  target="_blank"
  rel="noopener"
  hidden
  class="group mr-1 inline-flex h-7 shrink-0 items-center whitespace-nowrap gap-2 rounded-full border border-border-primary bg-white/[0.03] pr-3 pl-2.5 text-xs text-text-secondary transition-colors hover:border-accent/60 hover:text-white"
>
  <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
  <span><span id="release-pill-text"></span><span class="hidden sm:inline"> is out</span></span>
  <span class="text-text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true">→</span>
</a>

<script>
  const pill = document.querySelector<HTMLAnchorElement>('#release-pill');
  const text = document.getElementById('release-pill-text');

  if (pill && text) {
    fetch('/api/releases.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((release) => {
        if (!release || typeof release.tagName !== 'string' || release.tagName === '') return;
        if (typeof release.htmlUrl === 'string' && /^https:\/\/github\.com\/jR4dh3y\/BoxBox\/releases\/tag\/v[\w.-]+$/.test(release.htmlUrl)) pill.href = release.htmlUrl;
        text.textContent = release.tagName;
        pill.hidden = false;
      })
      .catch(() => {
        // No release info; the pill stays hidden.
      });
  }
</script>

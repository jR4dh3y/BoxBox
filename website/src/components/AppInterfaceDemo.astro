---
import DemoApp from './DemoApp.astro';
import { ChevronLeft, ChevronRight, Maximize2, Minimize2 } from '@lucide/astro';
---

<div id="demo" class="w-full max-w-[1400px] mt-24 mb-4 md:mt-28 flex flex-col items-center justify-center relative isolate" style="--hero-glow: rgba(146, 124, 255, 0.32);">
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-[86%] w-[118%] -translate-x-1/2 -translate-y-[42%] demo-hero-glow z-0"></div>
  <div
    id="demo-stage"
    class="w-full grid grid-cols-1 items-center transition-transform duration-300 ease-out origin-top relative z-10"
    style="transform: perspective(2000px) translateY(-50px) rotateX(20deg) scale(0.85);"
  >
  <div
    data-slide="0"
    data-active
    aria-label="BoxBox promo video"
    class="demo-slide col-start-1 row-start-1 w-full rounded-[14px] overflow-hidden border border-[#2a2a2a] bg-black"
    style="box-shadow: 0 24px 70px rgba(0, 0, 0, 0.72), 0 0 96px var(--hero-glow);"
  >
    <video
      id="demo-video"
      class="block w-full aspect-video"
      src="/media/boxbox-promo.mp4"
      poster="/media/boxbox-promo-poster.webp"
      muted
      playsinline
      controls
      preload="metadata"
    ></video>
  </div>
  <div
    id="app-window"
    data-slide="1"
    inert
    class="demo-slide col-start-1 row-start-1 w-full rounded-[14px] overflow-hidden border border-[#2a2a2a] bg-[#161616] relative"
    style="box-shadow: 0 24px 70px rgba(0, 0, 0, 0.72), 0 0 96px var(--hero-glow); --hero-glow: rgba(146, 124, 255, 0.32); --color-accent: #a892ff; --color-accent-hover: #7b69c5; --color-accent-muted: #473d68; --color-selection: #463c67; --color-selection-hover: #7b69c5; --color-border-focus: #a892ff;"
  >
    <div class="absolute inset-0 demo-wallpaper-layer"></div>
    <div id="demo-wallpaper-fade" class="absolute inset-0 demo-wallpaper-fade"></div>
    <div class="absolute inset-0 bg-black/35"></div>
    <DemoApp id="hero-app" class="h-[600px] w-full md:aspect-video md:h-auto" />
  </div>
  </div>
  <div class="relative z-10 mt-4 flex flex-wrap items-center justify-center gap-3 text-sm text-text-secondary">
    <button id="demo-prev" type="button" aria-label="Show promo video" class="demo-arrow" disabled>
      <ChevronLeft class="w-4 h-4" />
    </button>
    <p data-caption="0">BoxBox in 40 seconds. Music: <a href="https://www.youtube.com/watch?v=LL9VJAljSQs" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:text-white">“the kill 2” by Lex Amarni &amp; 2muchmotion</a></p>
    <p data-caption="1" hidden>This one is live. Open a drive, edit a file, or <a href="#sharing" class="text-accent underline underline-offset-4 hover:text-white">share a folder</a>.</p>
    <button id="demo-next" type="button" aria-label="Show interface preview" class="demo-arrow">
      <ChevronRight class="w-4 h-4" />
    </button>
    <button id="demo-theater" type="button" aria-pressed="false" class="demo-theater-toggle">
      <Maximize2 class="demo-theater-enter h-3.5 w-3.5" aria-hidden="true" /><Minimize2 class="demo-theater-exit h-3.5 w-3.5" aria-hidden="true" />
      <span>Theater mode</span>
    </button>
  </div>
</div>

<script>
  import { mountDemoApp } from '../lib/demo/app';
  import { activeTheme, applyAccent, onThemeChange, startThemeCycle, type Theme } from '../lib/siteTheme';

  const appWindow = document.getElementById('app-window');
  const demo = document.getElementById('demo');
  const stage = document.getElementById('demo-stage');
  const heroApp = document.getElementById('hero-app');
  const videoEl = document.getElementById('demo-video');
  const video = videoEl instanceof HTMLVideoElement ? videoEl : null;
  const prevEl = document.getElementById('demo-prev');
  const prevButton = prevEl instanceof HTMLButtonElement ? prevEl : null;
  const nextEl = document.getElementById('demo-next');
  const nextButton = nextEl instanceof HTMLButtonElement ? nextEl : null;
  const wallpaperFade = document.getElementById('demo-wallpaper-fade');
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The window wears the theme before the rest of the page does, so it sets
  // the colours on itself as well as following the page.
  function wearTheme(theme: Theme, shouldFade: boolean) {
    if (!appWindow || !demo) return;

    if (wallpaperFade && shouldFade) {
      wallpaperFade.style.transition = 'none';
      wallpaperFade.style.backgroundImage = appWindow.style.getPropertyValue('--hero-wallpaper');
      wallpaperFade.style.opacity = '1';
      wallpaperFade.offsetHeight;
      wallpaperFade.style.transition = '';
      appWindow.style.setProperty('--hero-wallpaper', `url('${theme.wallpaper}')`);
      window.requestAnimationFrame(() => {
        wallpaperFade.style.opacity = '0';
      });
    } else {
      appWindow.style.setProperty('--hero-wallpaper', `url('${theme.wallpaper}')`);
    }

    appWindow.style.setProperty('--hero-glow', theme.glow);
    applyAccent(appWindow, theme);
    demo.style.setProperty('--hero-glow', theme.glow);
  }

  if (appWindow && stage && heroApp) {
    const demoStage = stage;
    const previewWindow = appWindow;
    const preview = mountDemoApp(heroApp);
    let ticking = false;
    let previewShown = false;
    let theater = false;
    let lastProgress = -1;

    const THEATER_LEAVE_PX = 120;
    let theaterScrollY = 0;

    // Scrolling on is a way out of theater mode.
    function followScroll() {
      if (theater && Math.abs(window.scrollY - theaterScrollY) > THEATER_LEAVE_PX) setTheater(false);
    }

    function updateDemoTransform(force = false) {
      if (motionPreference.matches || theater) {
        if (lastProgress !== -2 || force) {
          demoStage.style.transform = 'none';
          lastProgress = -2;
        }
        return;
      }
      const scrollY = window.scrollY;
      const maxScroll = window.innerHeight * 0.6;
      const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
      if (!force && progress === lastProgress) return;
      lastProgress = progress;

      const easeProgress = 1 - Math.pow(1 - progress, 4);
      const rotateX = 20 - (20 * easeProgress);
      const scale = 0.85 + (0.15 * easeProgress);
      const translateY = -50 * (1 - easeProgress);

      demoStage.style.transform = `perspective(2000px) translateY(${translateY}px) rotateX(${rotateX}deg) scale(${scale})`;
    }

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        updateDemoTransform();
        followScroll();
        ticking = false;
      });
    }, { passive: true });

    motionPreference.addEventListener('change', () => updateDemoTransform(true));

    updateDemoTransform(true);
    onThemeChange((theme) => wearTheme(theme, true));

    // Slide 0 is the promo video, slide 1 the interface preview. The video
    // plays while it is the visible slide and hands over to the preview when
    // it ends. The first time the preview is shown the page takes on its theme
    // and a sample upload begins.
    let activeSlide = 0;
    let demoVisible = false;
    // Set when the visitor pauses with the native controls, so scrolling
    // back into view does not resume playback against their wishes.
    let userPaused = false;
    let syncPausesPending = 0;

    function syncVideo() {
      if (!video) return;
      if (activeSlide === 0 && demoVisible && !userPaused && !motionPreference.matches) {
        video.play().catch(() => {
          // Autoplay can be refused; the native controls still work.
        });
      } else if (!video.paused) {
        syncPausesPending += 1;
        video.pause();
      }
    }

    function showSlide(index: number) {
      activeSlide = index;
      document.querySelectorAll<HTMLElement>('#demo [data-slide]').forEach((slide) => {
        slide.toggleAttribute('data-active', Number(slide.dataset.slide) === index);
      });
      document.querySelectorAll<HTMLElement>('#demo [data-caption]').forEach((caption) => {
        caption.hidden = Number(caption.dataset.caption) !== index;
      });
      if (prevButton) prevButton.disabled = index === 0;
      if (nextButton) nextButton.disabled = index === 1;
      if (video) video.inert = index !== 0;
      previewWindow.inert = index !== 1;
      if (index === 1 && !previewShown) {
        previewShown = true;
        wearTheme(activeTheme(), false);
        startThemeCycle();
        preview.startUpload();
      }
      syncVideo();
    }

    prevButton?.addEventListener('click', () => {
      userPaused = false;
      showSlide(0);
      nextButton?.focus();
    });
    nextButton?.addEventListener('click', () => {
      showSlide(1);
      prevButton?.focus();
    });
    video?.addEventListener('ended', () => showSlide(1));
    video?.addEventListener('play', () => {
      userPaused = false;
    });
    video?.addEventListener('pause', () => {
      if (syncPausesPending > 0) {
        syncPausesPending -= 1;
        return;
      }
      if (video && !video.ended) userPaused = true;
    });

    document.addEventListener('keydown', (event) => {
      if (!demoVisible || event.altKey || event.ctrlKey || event.metaKey) return;
      const target = event.target;
      if (target instanceof Element && target.closest('input, textarea, select, video, [contenteditable]')) return;
      if (event.key === 'ArrowRight' && activeSlide === 0) showSlide(1);
      else if (event.key === 'ArrowLeft' && activeSlide === 1) {
        userPaused = false;
        showSlide(0);
      }
    });

    motionPreference.addEventListener('change', syncVideo);
    showSlide(0);

    // Theater mode: the page dims and the demo grows to fill the window,
    // without going full screen. The stage glides between its two places.
    const theaterButton = document.getElementById('demo-theater');
    const theaterLabel = theaterButton?.querySelector('span');
    const demoRoot = demo;

    function setTheater(on: boolean) {
      if (!demoRoot || on === theater) return;
      const first = demoStage.getBoundingClientRect();
      const slot = demoRoot.parentElement;
      // The demo leaves the page's flow; its slot keeps the page from moving.
      if (slot) slot.style.minHeight = on ? `${slot.offsetHeight}px` : '';
      theater = on;
      theaterScrollY = window.scrollY;
      demoRoot.toggleAttribute('data-theater', on);
      demoRoot.closest('section')?.toggleAttribute('data-theater', on);
      theaterButton?.setAttribute('aria-pressed', String(on));
      if (theaterLabel) theaterLabel.textContent = on ? 'Exit theater mode' : 'Theater mode';
      updateDemoTransform();
      if (motionPreference.matches) return;
      const last = demoStage.getBoundingClientRect();
      const from = `translate(${first.left - last.left}px, ${first.top - last.top}px) scale(${first.width / last.width}, ${first.height / last.height})`;
      demoStage.animate({ transformOrigin: ['top left', 'top left'], transform: [from, getComputedStyle(demoStage).transform] }, { duration: 450, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
    }

    theaterButton?.addEventListener('click', () => setTheater(!theater));
    // A click on the dimmed page, outside the demo, leaves theater mode.
    demoRoot?.addEventListener('click', (event) => {
      if (event.target === demoRoot) setTheater(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && theater) setTheater(false);
    });

    if ('IntersectionObserver' in window && demo) {
      const demoObserver = new IntersectionObserver((entries) => {
        demoVisible = entries.some((entry) => entry.isIntersecting);
        syncVideo();
      }, { threshold: 0.4 });

      demoObserver.observe(demo);
    } else {
      demoVisible = true;
      syncVideo();
    }
  }
</script>

<style>
  .demo-wallpaper-layer,
  .demo-wallpaper-fade {
    background-image: var(--hero-wallpaper);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.03);
  }

  .demo-wallpaper-layer {
    transition: transform 800ms ease;
  }

  .demo-wallpaper-fade {
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms ease;
  }

  .demo-slide {
    transition: opacity 500ms ease, visibility 500ms;
  }

  /* The hidden slide leaves the grid flow so the stage takes the height of
     the visible one; on mobile the interface is taller than the video. */
  .demo-slide:not([data-active]) {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    visibility: hidden;
  }

  .demo-theater-toggle {
    display: inline-flex;
    height: 2rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-primary, #333);
    color: var(--color-text-primary, #e5e5e5);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .demo-theater-toggle:hover,
  .demo-theater-toggle[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .demo-theater-toggle[aria-pressed='false'] .demo-theater-exit,
  .demo-theater-toggle[aria-pressed='true'] .demo-theater-enter { display: none; }

  /* Theater mode. The section rises above the nav, the demo covers the
     window with a dim backdrop, and the stage takes the room that is left. */
  :global(section[data-theater]) { z-index: 50; }

  #demo[data-theater] {
    position: fixed;
    inset: 0;
    z-index: 50;
    max-width: none;
    margin: 0;
    padding: 1rem;
    /* Wrapped captions on a small screen can still outgrow it. */
    overflow-y: auto;
  }

  #demo[data-theater]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.86);
    animation: theater-dim 300ms ease;
  }

  #demo[data-theater] #demo-stage {
    width: min(100%, calc((100dvh - 6rem) * 16 / 9));
    transition: none;
  }

  /* Below md the live preview has a fixed height rather than a ratio. */
  #demo[data-theater] :global(#hero-app) { height: min(600px, calc(100dvh - 8rem)); }

  @media (min-width: 768px) {
    #demo[data-theater] :global(#hero-app) { height: auto; }
  }

  @keyframes theater-dim {
    from { opacity: 0; }
  }

  .demo-arrow {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border-primary, #333);
    color: var(--color-text-primary, #e5e5e5);
    transition: color 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }

  .demo-arrow:hover:not(:disabled) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .demo-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-slide {
      transition: none;
    }
  }

  .demo-hero-glow {
    background:
      radial-gradient(ellipse 56% 52% at 50% 42%, var(--hero-glow, rgba(74, 158, 255, 0.32)) 0%, transparent 72%),
      radial-gradient(ellipse 52% 48% at 50% 84%, rgba(74, 158, 255, 0.16) 0%, transparent 70%);
    opacity: 0.9;
    transition: background 700ms ease, opacity 700ms ease;
  }
</style>

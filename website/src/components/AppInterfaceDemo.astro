---
import DriveCard from './DriveCard.astro';
import SidebarItem from './SidebarItem.astro';

import {
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  ChevronUp,
  Monitor,
  Download,
  FileText,
  Music,
  Image,
  Video,
  House,
  RefreshCw,
  Settings,
  List,
  LayoutGrid,
  LoaderCircle,
  X,
  Server,
  FilePlus,
  HardDrive,
  FolderUp,
  Upload
} from '@lucide/astro';
---

<div id="demo" class="w-full max-w-[1400px] mt-24 mb-32 flex flex-col items-center justify-center relative isolate" style="--hero-glow: rgba(146, 124, 255, 0.32);">
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-[86%] w-[118%] -translate-x-1/2 -translate-y-[42%] demo-hero-glow z-0"></div>
  <div
    id="demo-stage"
    class="w-full grid grid-cols-1 items-center transition-transform duration-300 ease-out origin-top relative z-10"
    style="transform: perspective(2000px) translateY(-50px) rotateX(20deg) scale(0.85);"
  >
  <div
    data-slide="0"
    data-active
    aria-label="BoxBox promo video"
    class="demo-slide col-start-1 row-start-1 w-full rounded-[14px] overflow-hidden border border-[#2a2a2a] bg-black"
    style="box-shadow: 0 24px 70px rgba(0, 0, 0, 0.72), 0 0 96px var(--hero-glow);"
  >
    <video
      id="demo-video"
      class="block w-full aspect-video"
      src="/media/boxbox-promo.mp4"
      poster="/media/boxbox-promo-poster.jpg"
      muted
      playsinline
      controls
      preload="metadata"
    ></video>
  </div>
  <div
    id="app-window"
    data-slide="1"
    inert
    class="demo-slide col-start-1 row-start-1 w-full rounded-[14px] overflow-hidden border border-[#2a2a2a] bg-[#161616] relative"
    style="box-shadow: 0 24px 70px rgba(0, 0, 0, 0.72), 0 0 96px var(--hero-glow); --hero-wallpaper: url('/wallpapers/evernight.png'); --hero-glow: rgba(146, 124, 255, 0.32); --color-accent: #a892ff; --color-accent-hover: #7b69c5; --color-accent-muted: #473d68; --color-selection: #463c67; --color-selection-hover: #7b69c5; --color-border-focus: #a892ff;"
  >
    <div class="absolute inset-0 demo-wallpaper-layer"></div>
    <div id="demo-wallpaper-fade" class="absolute inset-0 demo-wallpaper-fade"></div>
    <div class="absolute inset-0 bg-black/35"></div>

    <div class="flex h-[600px] md:h-auto md:aspect-video w-full bg-[#161616]/55 text-text-primary text-[13px] font-sans relative z-10 backdrop-blur-[2px]">
      <div class="w-[220px] min-w-[220px] bg-[#1e1e1e]/78 border-r border-[#2a2a2a] hidden md:flex md:flex-col backdrop-blur-md">
        <div class="border-b border-border-secondary">
          <button class="w-full flex items-center gap-1.5 px-3 py-2.5 text-text-secondary text-[11px] font-medium uppercase tracking-wide">
            <ChevronDown class="w-3.5 h-3.5" />
            <span>Drives</span>
          </button>
          <div class="pb-2">
            <SidebarItem icon={Server} label="This Server" active={true} />
            <SidebarItem icon={HardDrive} label="storage" />
            <SidebarItem icon={HardDrive} label="archive" />
            <SidebarItem icon={HardDrive} label="backups" />
          </div>
        </div>

        <div class="border-b border-border-secondary">
          <div class="flex items-center gap-1.5 px-3 py-2.5 text-text-secondary text-[11px] font-medium uppercase tracking-wide">
            <ChevronDown class="w-3.5 h-3.5" />
            <span>Places</span>
          </div>
          <div class="pb-2">
            <SidebarItem icon={Monitor} label="Desktop" />
            <SidebarItem icon={Download} label="Downloads" />
            <SidebarItem icon={FileText} label="Documents" />
            <SidebarItem icon={Music} label="Music" />
            <SidebarItem icon={Image} label="Pictures" />
            <SidebarItem icon={Video} label="Videos" />
          </div>
        </div>

        <div class="border-b border-border-secondary flex-1">
          <button class="w-full flex items-center gap-1.5 px-3 py-2.5 text-text-secondary text-[11px] font-medium uppercase tracking-wide">
            <ChevronDown class="w-3.5 h-3.5" />
            <span>Favorites</span>
          </button>
          <div class="py-2 px-5 text-text-muted text-xs italic">
            No favorites yet
          </div>
        </div>
      </div>

      <div class="flex-1 flex flex-col min-w-0 bg-[#161616]/45 backdrop-blur-sm">
        <div class="h-14 border-b border-[#2a2a2a] flex items-center px-4 justify-between bg-[#1e1e1e]/82 backdrop-blur-md">
          <div class="flex items-center gap-0.5">
            <button class="w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-surface-elevated rounded transition-colors"><ChevronLeft class="w-[18px] h-[18px]" /></button>
            <button class="w-7 h-7 flex items-center justify-center text-text-disabled cursor-not-allowed"><ChevronRight class="w-[18px] h-[18px]" /></button>
            <button class="w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-surface-elevated rounded transition-colors"><ChevronUp class="w-[18px] h-[18px]" /></button>
          </div>

          <div class="flex-1 mx-4 relative">
            <div class="bg-surface-secondary border border-border-primary rounded flex items-center px-2 py-1 max-w-full overflow-hidden h-8">
              <button class="w-4.5 h-4.5 flex items-center justify-center text-text-secondary shrink-0 mr-1.5">
                <House class="w-3.5 h-3.5" />
              </button>
              <span class="text-text-primary text-[13px]">This Server</span>
            </div>
          </div>

          <div class="flex items-center gap-1">
            <button aria-label="Upload files" class="w-7 h-7 flex items-center justify-center text-text-secondary"><Upload class="w-4 h-4" /></button>
            <button aria-label="Upload folder" class="w-7 h-7 flex items-center justify-center text-text-secondary"><FolderUp class="w-4 h-4" /></button>
            <button class="w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-surface-elevated rounded transition-colors"><FilePlus class="w-4 h-4" /></button>
            <button class="w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-surface-elevated rounded transition-colors"><RefreshCw class="w-4 h-4" /></button>
            <button class="w-7 h-7 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-surface-elevated rounded transition-colors"><Settings class="w-4 h-4" /></button>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto mock-scrollbar p-6 bg-surface-primary/35 backdrop-blur-[1.5px]">
          <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4 text-left">
            <DriveCard
              path="root"
              total="217.97 GB"
              used="105.22 GB"
              free="101.61 GB"
              device="/dev/sda2"
              fs="ext4"
              percent={48.3}
              color="var(--color-accent)"
            />
            <DriveCard
              path="storage"
              total="223.57 GB"
              used="211.18 GB"
              free="12.39 GB"
              device="/dev/sdc1"
              fs="fuseblk"
              percent={94.5}
              color="#ef4165"
            />
            <DriveCard
              path="archive"
              total="101.56 TB"
              used="61.24 TB"
              free="40.32 TB"
              device="archive_remote:"
              fs="fuse.rclone"
              percent={60.3}
              color="var(--color-accent)"
            />
            <DriveCard
              path="backups"
              total="5 TB"
              used="59.67 GB"
              free="4.94 TB"
              device="backups_remote:"
              fs="fuse.rclone"
              percent={1.2}
              color="var(--color-accent)"
            />
            <DriveCard
              path="home"
              total="217.97 GB"
              used="105.22 GB"
              free="101.61 GB"
              device="/dev/sda2"
              fs="ext4"
              percent={48.3}
              color="var(--color-accent)"
            />
          </div>
        </div>

        <div class="h-8 bg-surface-primary/70 border-t border-border-secondary flex items-center px-4 justify-between text-[11px] text-text-secondary backdrop-blur-md">
          <div class="flex items-center gap-3">
            <span>5 items</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex gap-0.5 bg-surface-secondary border border-border-primary rounded p-0.5">
              <button class="w-[20px] h-[20px] flex items-center justify-center text-text-muted hover:text-text-secondary"><List class="w-3.5 h-3.5" /></button>
              <button class="w-[20px] h-[20px] flex items-center justify-center bg-surface-elevated text-text-primary rounded-sm"><LayoutGrid class="w-3.5 h-3.5" /></button>
            </div>
          </div>
        </div>
      </div>

      <div class="absolute bottom-12 right-3 sm:right-6 w-[calc(100%-1.5rem)] max-w-[360px] bg-surface-secondary/92 border border-border-primary rounded-lg shadow-2xl overflow-hidden animate-fade-in-up backdrop-blur-md" style="animation-delay: 1s; z-index: 60; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
        <div class="px-4 py-2 border-b border-border-primary flex items-center justify-between text-[12px] font-medium bg-surface-tertiary/95">
          <span class="text-text-primary flex items-center gap-2">
            <LoaderCircle class="w-3.5 h-3.5 text-accent animate-spin" />
            Uploading summer-photos...
          </span>
          <button class="text-text-muted hover:text-text-primary">
            <X class="w-3.5 h-3.5" />
          </button>
        </div>
        <div class="p-4 flex flex-col gap-2.5">
          <div class="flex items-center justify-between text-xs">
            <span class="text-text-primary font-medium truncate pr-4">summer-photos/2026/sunset.jpg</span>
            <span class="text-text-secondary font-mono text-[10px] shrink-0">1.8 / 2.4 MB</span>
          </div>
          <div class="w-full bg-surface-elevated rounded-full h-1.5 overflow-hidden">
            <div class="bg-accent h-full rounded-full transition-all duration-300 relative" style="width: 74%">
              <div class="absolute inset-0 bg-white/20 animate-pulse"></div>
            </div>
          </div>
          <div class="flex justify-between text-[10px] text-text-muted mt-1 font-mono">
            <span>74% &middot; 2 of 3 files</span>
            <span>Paths preserved</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
  <div class="mt-4 flex items-center justify-center gap-3 text-sm text-text-secondary">
    <button id="demo-prev" type="button" aria-label="Show promo video" class="demo-arrow" disabled>
      <ChevronLeft class="w-4 h-4" />
    </button>
    <p data-caption="0">BoxBox in 40 seconds. Music: <a href="https://www.youtube.com/watch?v=LL9VJAljSQs" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:text-white">“the kill 2” by Lex Amarni &amp; 2muchmotion</a></p>
    <p data-caption="1" hidden>Interface preview with sample files and storage. <a href="#sharing" class="text-accent underline underline-offset-4 hover:text-white">Explore folder sharing</a></p>
    <button id="demo-next" type="button" aria-label="Show interface preview" class="demo-arrow">
      <ChevronRight class="w-4 h-4" />
    </button>
  </div>
</div>

<script>
  const appWindow = document.getElementById('app-window');
  const demo = document.getElementById('demo');
  const stage = document.getElementById('demo-stage');
  const video = document.getElementById('demo-video') as HTMLVideoElement | null;
  const prevButton = document.getElementById('demo-prev') as HTMLButtonElement | null;
  const nextButton = document.getElementById('demo-next') as HTMLButtonElement | null;
  const wallpaperFade = document.getElementById('demo-wallpaper-fade');
  const root = document.documentElement;
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

  const themes = [
    {
      wallpaper: '/wallpapers/evernight.png',
      accent: '#a892ff',
      glow: 'rgba(146, 124, 255, 0.26)'
    },
    {
      wallpaper: '/wallpapers/light.png',
      accent: '#5ea8ff',
      glow: 'rgba(94, 168, 255, 0.28)'
    },
    {
      wallpaper: '/wallpapers/lucy.jpeg',
      accent: '#ff7ab8',
      glow: 'rgba(255, 122, 184, 0.28)'
    },
    {
      wallpaper: '/wallpapers/minami.jpg',
      accent: '#7ed3ff',
      glow: 'rgba(126, 211, 255, 0.24)'
    },
    {
      wallpaper: '/wallpapers/summer_1.png',
      accent: '#ff9f70',
      glow: 'rgba(255, 159, 112, 0.26)'
    }
  ];

  function hexToRgb(hex: string) {
    const cleaned = hex.replace('#', '');
    return [
      Number.parseInt(cleaned.slice(0, 2), 16),
      Number.parseInt(cleaned.slice(2, 4), 16),
      Number.parseInt(cleaned.slice(4, 6), 16)
    ];
  }

  function rgbToHex(rgb: number[]) {
    return `#${rgb.map((value) => Math.round(value).toString(16).padStart(2, '0')).join('')}`;
  }

  function mixHex(color: string, target: string, amount: number) {
    const [r1, g1, b1] = hexToRgb(color);
    const [r2, g2, b2] = hexToRgb(target);
    return rgbToHex([
      r1 + (r2 - r1) * amount,
      g1 + (g2 - g1) * amount,
      b1 + (b2 - b1) * amount
    ]);
  }

  function setThemeVars(target: HTMLElement, theme: typeof themes[number]) {
    target.style.setProperty('--color-accent', theme.accent);
    target.style.setProperty('--color-border-focus', theme.accent);
    target.style.setProperty('--color-accent-hover', mixHex(theme.accent, '#000000', 0.28));
    target.style.setProperty('--color-accent-muted', mixHex(theme.accent, '#1b1b1b', 0.58));
    target.style.setProperty('--color-selection', mixHex(theme.accent, '#1e1e1e', 0.6));
    target.style.setProperty('--color-selection-hover', mixHex(theme.accent, '#000000', 0.35));
  }

  function applyTheme(theme: typeof themes[number], shouldFade = true, syncSiteAccent = false) {
    if (!appWindow || !demo) return;

    if (wallpaperFade && shouldFade) {
      wallpaperFade.style.transition = 'none';
      wallpaperFade.style.backgroundImage = appWindow.style.getPropertyValue('--hero-wallpaper');
      wallpaperFade.style.opacity = '1';
      wallpaperFade.offsetHeight;
      wallpaperFade.style.transition = '';
      appWindow.style.setProperty('--hero-wallpaper', `url('${theme.wallpaper}')`);
      window.requestAnimationFrame(() => {
        wallpaperFade.style.opacity = '0';
      });
    } else {
      appWindow.style.setProperty('--hero-wallpaper', `url('${theme.wallpaper}')`);
    }

    appWindow.style.setProperty('--hero-glow', theme.glow);
    setThemeVars(appWindow, theme);

    if (syncSiteAccent) {
      root.dataset.accentTransition = 'true';
      setThemeVars(root, theme);
    }

    demo.style.setProperty('--hero-glow', theme.glow);
  }

  if (appWindow && stage) {
    const demoStage = stage;
    let ticking = false;
    let themeIndex = 0;
    let themeStarted = false;
    let themeInterval: number | undefined;

    function updateDemoTransform() {
      if (motionPreference.matches) {
        demoStage.style.transform = 'none';
        return;
      }
      const scrollY = window.scrollY;
      const maxScroll = window.innerHeight * 0.6;
      const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
      const easeProgress = 1 - Math.pow(1 - progress, 4);
      const rotateX = 20 - (20 * easeProgress);
      const scale = 0.85 + (0.15 * easeProgress);
      const translateY = -50 * (1 - easeProgress);

      demoStage.style.transform = `perspective(2000px) translateY(${translateY}px) rotateX(${rotateX}deg) scale(${scale})`;
    }

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        updateDemoTransform();
        ticking = false;
      });
    }, { passive: true });

    function syncThemeCycle() {
      if (themeInterval !== undefined) {
        window.clearInterval(themeInterval);
        themeInterval = undefined;
      }
      if (!themeStarted || motionPreference.matches) return;
      themeInterval = window.setInterval(() => {
        themeIndex = (themeIndex + 1) % themes.length;
        applyTheme(themes[themeIndex], true, true);
      }, 4800);
    }

    function startThemeCycle() {
      if (themeStarted) return;
      themeStarted = true;
      applyTheme(themes[themeIndex], false, true);
      syncThemeCycle();
    }

    motionPreference.addEventListener('change', () => {
      updateDemoTransform();
      syncThemeCycle();
    });

    updateDemoTransform();
    applyTheme(themes[themeIndex], false, false);

    // Slide 0 is the promo video, slide 1 the interface preview. The video
    // plays while it is the visible slide and hands over to the preview when
    // it ends; the theme cycle starts the first time the preview is shown.
    let activeSlide = 0;
    let demoVisible = false;
    // Set when the visitor pauses with the native controls, so scrolling
    // back into view does not resume playback against their wishes.
    let userPaused = false;

    function syncVideo() {
      if (!video) return;
      if (activeSlide === 0 && demoVisible && !userPaused && !motionPreference.matches) {
        video.play().catch(() => {
          // Autoplay can be refused; the native controls still work.
        });
      } else {
        video.pause();
      }
    }

    function showSlide(index: number) {
      activeSlide = index;
      document.querySelectorAll<HTMLElement>('#demo [data-slide]').forEach((slide) => {
        slide.toggleAttribute('data-active', Number(slide.dataset.slide) === index);
      });
      document.querySelectorAll<HTMLElement>('#demo [data-caption]').forEach((caption) => {
        caption.hidden = Number(caption.dataset.caption) !== index;
      });
      if (prevButton) prevButton.disabled = index === 0;
      if (nextButton) nextButton.disabled = index === 1;
      if (video) video.inert = index !== 0;
      if (index === 1) startThemeCycle();
      syncVideo();
    }

    prevButton?.addEventListener('click', () => {
      userPaused = false;
      showSlide(0);
      nextButton?.focus();
    });
    nextButton?.addEventListener('click', () => {
      showSlide(1);
      prevButton?.focus();
    });
    video?.addEventListener('ended', () => showSlide(1));
    video?.addEventListener('play', () => {
      userPaused = false;
    });
    video?.addEventListener('pause', () => {
      // Pauses issued by syncVideo happen off-screen or on the other slide.
      if (video && activeSlide === 0 && demoVisible && !video.ended) userPaused = true;
    });

    document.addEventListener('keydown', (event) => {
      if (!demoVisible || event.altKey || event.ctrlKey || event.metaKey) return;
      const target = event.target;
      if (target instanceof Element && target.closest('input, textarea, select, video, [contenteditable]')) return;
      if (event.key === 'ArrowRight' && activeSlide === 0) showSlide(1);
      else if (event.key === 'ArrowLeft' && activeSlide === 1) {
        userPaused = false;
        showSlide(0);
      }
    });

    motionPreference.addEventListener('change', syncVideo);
    showSlide(0);

    if ('IntersectionObserver' in window && demo) {
      const demoObserver = new IntersectionObserver((entries) => {
        demoVisible = entries.some((entry) => entry.isIntersecting);
        syncVideo();
      }, { threshold: 0.4 });

      demoObserver.observe(demo);
    } else {
      demoVisible = true;
      syncVideo();
    }
  }
</script>

<style>
  .demo-wallpaper-layer,
  .demo-wallpaper-fade {
    background-image: var(--hero-wallpaper);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.03);
  }

  .demo-wallpaper-layer {
    transition: transform 800ms ease;
  }

  .demo-wallpaper-fade {
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms ease;
  }

  .demo-slide {
    transition: opacity 500ms ease, visibility 500ms;
  }

  /* The hidden slide leaves the grid flow so the stage takes the height of
     the visible one; on mobile the interface is taller than the video. */
  .demo-slide:not([data-active]) {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    visibility: hidden;
  }

  .demo-arrow {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border-primary, #333);
    color: var(--color-text-primary, #e5e5e5);
    transition: color 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }

  .demo-arrow:hover:not(:disabled) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .demo-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-slide {
      transition: none;
    }
  }

  .demo-hero-glow {
    background:
      radial-gradient(ellipse at 50% 42%, var(--hero-glow, rgba(74, 158, 255, 0.32)) 0%, transparent 58%),
      radial-gradient(ellipse at 50% 88%, rgba(74, 158, 255, 0.18) 0%, transparent 64%);
    filter: blur(72px);
    opacity: 0.95;
    transition: background 700ms ease, opacity 700ms ease;
  }
</style>

---
// The hero's actions are drawn as the app's own context menu, opened on the
// filename being renamed in the headline.
import { ArrowRight, Download, GitFork } from '@lucide/astro';
---

<nav aria-label="Get BoxBox" class="hero-menu w-full max-w-[23rem] md:w-[23rem] rounded-lg border border-border-primary bg-surface-primary p-1.5 text-[15px] shadow-[0_24px_48px_-16px_rgba(0,0,0,0.85)]">
  <a href="/docs/quickstart/" class="hero-menu-item hero-menu-primary">
    <ArrowRight class="h-4 w-4" aria-hidden="true" />
    <span class="flex-1 font-semibold">Get started</span>
    <span class="hero-menu-hint">Docker Compose</span>
  </a>
  <a href="/download/#desktop" class="hero-menu-item">
    <Download class="h-4 w-4 text-text-secondary" aria-hidden="true" />
    <span class="flex-1">Download for Linux</span>
    <span class="hero-menu-hint">x86_64</span>
  </a>
  <div class="mx-2 my-1.5 h-px bg-border-secondary"></div>
  <a href="https://github.com/jR4dh3y/BoxBox" target="_blank" rel="noopener" class="hero-menu-item">
    <GitFork class="h-4 w-4 text-text-secondary" aria-hidden="true" />
    <span class="flex-1">View source</span>
    <span class="hero-menu-hint">MIT</span>
  </a>
</nav>

<style>
  .hero-menu-item {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.375rem;
    padding: 0 0.75rem;
    color: var(--color-text-primary);
    transition: background-color 120ms ease, color 120ms ease;
  }

  .hero-menu-item:hover {
    background: var(--color-selection);
    color: #fff;
  }

  .hero-menu-primary,
  .hero-menu-primary:hover {
    background: var(--color-accent-solid);
    color: #fff;
  }

  .hero-menu-primary:hover { background: var(--color-accent-solid-hover); }

  .hero-menu-hint {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .hero-menu-item:hover .hero-menu-hint,
  .hero-menu-primary .hero-menu-hint { color: rgb(255 255 255 / 0.8); }
</style>

---
// The pitch continues as one sentence in the hero's type. Each boxed word
// puts the live preview beside it into the state it names, and the visitor
// can carry on from there.
import DemoApp from './DemoApp.astro';
---

<div id="walkthrough" class="grid items-center gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-14">
  <div>
    <p class="walk-text font-display">Your <button type="button" class="word-box" data-scene="browse" aria-pressed="true">drives</button> open like local folders. Drag in a whole folder and it uploads in chunks, paths intact. Fix a <button type="button" class="word-box" data-scene="editor" aria-pressed="false">config</button> without SSH. <button type="button" class="word-box" data-scene="preview" aria-pressed="false">Preview</button> a file before you download it. Send a <button type="button" id="sharing" class="word-box scroll-mt-32" data-scene="share" aria-pressed="false">link</button> that expires on its own, with <button type="button" class="word-box" data-scene="share-page" aria-pressed="false">no account</button> needed to open it.</p>
    <p class="mt-8 leading-relaxed text-text-secondary">
      Copy, move, and delete run in the background with live progress. There is search, read-only mounts, multiple users, and rate limits. It is free and MIT licensed.
    </p>
  </div>

  <div class="walk-stage order-first lg:order-none">
    <div class="walk-frame">
      <div class="walk-scale">
        <DemoApp id="walk-app" class="h-full w-full bg-[#161616]" />
      </div>
    </div>
    <p class="mt-3 hidden text-center text-sm text-text-muted lg:block">Not a screenshot. Click around, with sample files.</p>
  </div>
</div>

<script>
  import { mountDemoApp, type Scene } from '../lib/demo/app';

  const scenes: readonly Scene[] = ['browse', 'editor', 'preview', 'share', 'share-page'];
  const walkthrough = document.getElementById('walkthrough');
  const walkApp = document.getElementById('walk-app');

  if (walkthrough && walkApp) {
    const preview = mountDemoApp(walkApp);
    const words = Array.from(walkthrough.querySelectorAll<HTMLButtonElement>('[data-scene]'));
    let current = 0;
    let tour: number | undefined;

    function show(index: number) {
      current = index;
      words.forEach((word, wordIndex) => word.setAttribute('aria-pressed', String(wordIndex === index)));
      const scene = scenes.find((candidate) => candidate === words[index]?.dataset.scene);
      if (scene) preview.show(scene);
    }

    // The highlight walks through the sentence on its own until the visitor
    // picks a word or touches the preview.
    function endTour() {
      window.clearInterval(tour);
      tour = undefined;
      observer?.disconnect();
    }

    words.forEach((word, index) => {
      word.addEventListener('click', () => {
        endTour();
        show(index);
      });
    });
    walkApp.addEventListener('pointerdown', endTour);
    walkApp.addEventListener('focusin', endTour);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    reduceMotion.addEventListener('change', () => { if (reduceMotion.matches) endTour(); });
    const observer = reduceMotion.matches || !('IntersectionObserver' in window) ? undefined : new IntersectionObserver((entries) => {
      const visible = entries.some((entry) => entry.isIntersecting);
      window.clearInterval(tour);
      tour = visible ? window.setInterval(() => show((current + 1) % words.length), 3600) : undefined;
    }, { threshold: 0.5 });
    observer?.observe(walkthrough);

    // "#sharing" links, on load or from elsewhere on the page, pick the share
    // scene the way a click on that word does.
    const sharing = words.findIndex((word) => word.id === 'sharing');
    window.addEventListener('hashchange', () => {
      if (window.location.hash !== '#sharing') return;
      endTour();
      show(sharing);
    });
    show(window.location.hash === '#sharing' ? sharing : 0);
  }
</script>

<style>
  .walk-text {
    font-size: clamp(1.7rem, 2.9vw, 2.5rem);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.025em;
    color: #fff;
  }

  /* On small screens the preview stays pinned while the sentence scrolls
     under it, so a tapped word always has its result in view. */
  .walk-stage {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 0 -1.25rem;
    padding: 0.75rem 1.25rem;
    background: #0d0d0d;
  }

  .walk-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border-secondary);
    border-radius: 14px;
    background: #161616;
    box-shadow: 0 40px 80px -36px rgb(0 0 0 / 0.95);
  }

  /* The interface is drawn smaller than life so a whole window fits beside
     the sentence. */
  .walk-scale {
    width: 100%;
    height: 100%;
    zoom: 0.72;
  }

  /* A landscape phone has no room to pin the preview over the text. */
  @media (max-width: 1023px) and (min-aspect-ratio: 4 / 5) {
    .walk-stage { position: static; }
  }

  @media (min-width: 1024px) {
    .walk-stage {
      position: static;
      margin: 0;
      padding: 0;
      background: none;
    }

    .walk-frame { aspect-ratio: 16 / 10; }
    .walk-scale { zoom: 0.8; }
  }
</style>

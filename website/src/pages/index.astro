---
import Layout from '../layouts/Layout.astro';
import FeaturesBento from '../components/FeaturesBento.astro';
import AppInterfaceDemo from '../components/AppInterfaceDemo.astro';
import ReleaseBanner from '../components/ReleaseBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';

import {
  CirclePlay,
  GitFork,
  Download
} from '@lucide/astro';
---
<Layout title="BoxBox | Self-hosted File Manager & Linux Desktop" description="Manage local files with the Linux desktop app, or self-host BoxBox to browse and share your server files. Pair both in one workspace.">
<ReleaseBanner />
<section class="relative min-h-screen flex flex-col items-center justify-start pt-20 pb-20 px-4 text-center overflow-hidden z-10">

  <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 max-w-5xl mx-auto tracking-tight leading-tight animate-fade-in-up text-white" style="animation-delay: 200ms;">
    The file manager your <span class="text-accent">homelab</span> deserves.
  </h1>

  <p class="text-lg md:text-2xl text-text-secondary max-w-3xl mx-auto mb-12 font-medium leading-relaxed animate-fade-in-up" style="animation-delay: 300ms;">
    Browse your server like local folders. Upload whole directories, edit code, and share files or folders with the access you choose.
  </p>

  <div id="desktop" class="mb-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm animate-fade-in-up" style="animation-delay: 350ms;">
    <p class="text-text-secondary">Now available as a Linux desktop app.</p>
    <a href="/download/#desktop" class="inline-flex min-h-11 items-center gap-2 font-semibold text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <Download class="h-4 w-4" /> Download for Linux
    </a>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 400ms;">
    <a href="/docs/quickstart/" class="bg-accent-solid hover:bg-accent-solid-hover text-white font-semibold text-lg px-8 py-4 rounded-lg flex items-center gap-2 transition-all">
      <CirclePlay class="w-5 h-5" />
      Get started
    </a>
    <a href="https://github.com/jR4dh3y/BoxBox" target="_blank" class="glass-panel text-text-primary hover:text-white font-semibold text-lg px-8 py-4 rounded-lg flex items-center gap-2 transition-all">
      <GitFork class="w-5 h-5" />
      GitHub
    </a>
  </div>

  <AppInterfaceDemo />
</section>

<!-- Features Section -->
<FeaturesBento />

<!-- Footer -->
<SiteFooter />

</Layout>

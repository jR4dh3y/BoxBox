---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroActions from '../components/HeroActions.astro';
import AppInterfaceDemo from '../components/AppInterfaceDemo.astro';
import ProductTour from '../components/ProductTour.astro';
import Quickstart from '../components/Quickstart.astro';
import ReleaseBanner from '../components/ReleaseBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Layout title="BoxBox | Self-hosted File Manager & Linux Desktop" description="Manage local files with the Linux desktop app, or self-host BoxBox to browse and share your server files. Pair both in one workspace.">
<ReleaseBanner />
<SiteNav />

<main>
<section class="relative z-10 overflow-hidden px-5 pt-10 pb-16 md:px-8 md:pt-20">
  <div class="mx-auto max-w-7xl">
    <h1 class="hero-title font-display animate-fade-in-up font-extrabold text-white" style="animation-delay: 100ms;">
      The file manager your <span class="hero-rename"><span id="hero-rename-word" aria-hidden="true">homelab</span><span class="sr-only">homelab, NAS, or server</span></span> deserves.
    </h1>

    <div class="mt-10 grid gap-8 md:mt-14 md:grid-cols-[1fr_auto] md:items-end md:gap-16">
      <p class="animate-fade-in-up max-w-xl text-lg leading-relaxed text-text-secondary md:text-xl" style="animation-delay: 200ms;">
        Browse your server like local folders. Upload whole directories, edit code, and share files or folders with the access you choose.
      </p>
      <div class="animate-fade-in-up" style="animation-delay: 300ms;">
        <HeroActions />
      </div>
    </div>
  </div>

  <div class="flex justify-center">
    <AppInterfaceDemo />
  </div>
</section>

<ProductTour />

<Quickstart />
</main>

<SiteFooter />

</Layout>

<script>
  // Cycles the renamed word the way a rename works: select all, then type
  // over it. "homelab" is the longest word, so the headline never reflows.
  const word = document.getElementById('hero-rename-word');
  const names = ['homelab', 'NAS', 'server'];

  async function rename(target: HTMLElement) {
    const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));
    for (let index = 1; ; index = (index + 1) % names.length) {
      await wait(2600);
      target.toggleAttribute('data-selected', true);
      await wait(700);
      target.toggleAttribute('data-selected', false);
      target.textContent = '';
      for (const letter of names[index]) {
        await wait(95);
        target.textContent += letter;
      }
    }
  }

  if (word && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) void rename(word);
</script>

<style>
  .hero-title {
    max-width: 15ch;
    font-size: clamp(2.75rem, 8.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  /* The word is drawn as a filename mid-rename: boxed, caret at the end, and
     selected just before it is typed over. */
  .hero-rename {
    display: inline-block;
    min-width: 1.1em;
    margin: 0 -0.04em;
    padding: 0 0.1em 0.06em;
    border: 0.035em solid var(--color-accent);
    border-radius: 0.1em;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    line-height: 1;
  }

  #hero-rename-word {
    border-radius: 0.04em;
    transition: background-color 120ms ease, color 120ms ease;
  }

  #hero-rename-word[data-selected] {
    background: var(--color-accent-solid);
    color: #fff;
  }

  .hero-rename::after {
    content: '';
    display: inline-block;
    width: 0.045em;
    height: 0.78em;
    margin-left: 0.05em;
    vertical-align: -0.04em;
    background: currentColor;
    animation: rename-caret 1.1s steps(1) infinite;
  }

  @keyframes rename-caret {
    50% { opacity: 0; }
  }
</style>

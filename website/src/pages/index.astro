---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import GetBoxBox from '../components/GetBoxBox.astro';
import Closing from '../components/Closing.astro';
import AppInterfaceDemo from '../components/AppInterfaceDemo.astro';
import Walkthrough from '../components/Walkthrough.astro';
import ReleaseBanner from '../components/ReleaseBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Layout title="BoxBox | Self-hosted File Manager & Linux Desktop" description="Manage local files with the Linux desktop app, or self-host BoxBox to browse and share your server files. Pair both in one workspace.">
<ReleaseBanner />
<SiteNav />

<main>
<section class="relative z-10 overflow-hidden px-5 pt-10 pb-16 md:px-8 md:pt-20">
  <div class="mx-auto max-w-7xl">
    <h1 class="hero-title font-display animate-fade-in-up font-extrabold text-white" style="animation-delay: 100ms;">
      The file manager <br class="md:hidden" />your <br class="hidden md:block" /><span class="word-box hero-rename"><span id="hero-rename-window"><span id="hero-rename-word" aria-hidden="true">homelab</span></span><span class="sr-only">homelab, NAS, or server</span></span> <br class="md:hidden" />deserves.
    </h1>

    <div class="mt-8 flex flex-col gap-8 md:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <p class="animate-fade-in-up max-w-xl text-lg leading-relaxed text-text-secondary md:text-xl" style="animation-delay: 200ms;">
        Browse your server like local folders. Upload whole directories, edit code, and share files or folders with the access you choose.
      </p>
      <div class="animate-fade-in-up shrink-0" style="animation-delay: 300ms;">
        <GetBoxBox />
      </div>
    </div>
  </div>

  <div class="flex justify-center">
    <AppInterfaceDemo />
  </div>
</section>

<section id="features" class="relative z-10 scroll-mt-8 bg-[#0d0d0d] px-5 pt-10 pb-24 md:px-8 md:pt-16 md:pb-36">
  <h2 class="sr-only">What BoxBox does and how to run it</h2>
  <div class="mx-auto flex max-w-7xl flex-col gap-24 md:gap-36">
    <Walkthrough />
    <Closing />
  </div>
</section>
</main>

<SiteFooter />

</Layout>

<script>
  // The next name slides up into the box, like a list scrolling one row, and
  // the box follows its width.
  const frame = document.getElementById('hero-rename-window');
  const word = document.getElementById('hero-rename-word');
  const names = ['homelab', 'NAS', 'server'];

  function slideTo(view: HTMLElement, target: HTMLElement, next: string) {
    const timing = { duration: 700, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' };
    const from = view.getBoundingClientRect().width;
    const leaving = document.createElement('span');
    leaving.textContent = target.textContent;
    leaving.setAttribute('aria-hidden', 'true');
    leaving.style.cssText = 'position:absolute;left:0;top:0';
    view.append(leaving);
    target.textContent = next;
    const to = target.getBoundingClientRect().width;
    view.animate({ width: [`${from}px`, `${to}px`] }, timing);
    target.animate({ transform: ['translateY(110%)', 'translateY(0)'] }, timing);
    leaving.animate({ transform: ['translateY(0)', 'translateY(-110%)'] }, timing).finished.then(() => leaving.remove());
  }

  if (frame && word && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let index = 0;
    window.setInterval(() => {
      index = (index + 1) % names.length;
      slideTo(frame, word, names[index]);
    }, 3000);
  }
</script>

<style>
  .hero-title {
    font-size: clamp(2.75rem, 8.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  /* Clips the sliding names above and below, but not at the sides where a
     letter can overhang. overflow: hidden would also move the baseline. */
  #hero-rename-window {
    position: relative;
    display: inline-block;
    line-height: 1.1;
    clip-path: inset(0 -0.15em);
  }

  #hero-rename-word { display: inline-block; }
</style>

---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DesktopDownload from '../components/DesktopDownload.astro';
import { ArrowLeft, Monitor, Server, ArrowUpRight } from '@lucide/astro';
---
<Layout title="Download BoxBox | Desktop & Self-hosted Server" description="Get BoxBox Files for Windows x64 or Linux x86_64, or deploy the BoxBox server with Docker. Choose the right package, verify checksums, and connect your files.">
  <main class="relative z-10 mx-auto w-full max-w-6xl flex-1 px-5 pt-10 pb-24 md:pt-16">
    <a href="/" class="inline-flex min-h-11 items-center gap-2 text-sm text-text-secondary hover:text-white"><ArrowLeft class="h-4 w-4" /> BoxBox home</a>
    <h1 class="mt-10 text-5xl font-bold tracking-tight text-white md:text-7xl">Get BoxBox.</h1>
    <p class="mt-6 text-xl leading-relaxed text-text-secondary">A desktop app for your computer. A self-hosted server for your homelab. Use either on its own, or pair them together.</p>
    <!-- Both columns share four rows (intro, button, links, notes) so their buttons line up. -->
    <div class="mt-14 grid gap-12 border-y border-border-primary py-10 md:grid-cols-2 md:grid-rows-[repeat(4,auto)] md:gap-x-16 md:gap-y-0 md:py-14">
      <section id="desktop" aria-labelledby="desktop-heading" class="min-w-0 md:row-span-4 md:grid md:grid-rows-subgrid">
        <div class="mb-6">
          <Monitor class="mb-5 h-8 w-8 text-accent" />
          <h2 id="desktop-heading" class="text-3xl font-bold text-white">BoxBox Files</h2>
          <p class="mt-3 leading-relaxed text-text-secondary">Browse local files on Windows or Linux without a server, or connect to a BoxBox server running the pairing API.</p>
        </div>
        <DesktopDownload>
          <p>Extract and run the Windows ZIP. See the installation guide for Linux packages, AppImages and system requirements. macOS packages are not available.</p>
        </DesktopDownload>
      </section>
      <section aria-labelledby="server-heading" class="min-w-0 border-t border-border-primary pt-10 md:row-span-4 md:grid md:grid-rows-subgrid md:border-t-0 md:border-l md:pt-0 md:pl-12">
        <div class="mb-6">
          <Server class="mb-5 h-8 w-8 text-accent" />
          <h2 id="server-heading" class="text-3xl font-bold text-white">Self-hosted server</h2>
          <p class="mt-3 leading-relaxed text-text-secondary">Deploy with Docker on Linux amd64 or arm64. Browse from any modern browser, create share links, and authorize desktop clients.</p>
        </div>
        <div><a href="/docs/quickstart/" class="inline-flex min-h-12 items-center gap-2 rounded-lg bg-accent-solid px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-solid-hover">Deploy with Docker <ArrowUpRight class="h-5 w-5" /></a></div>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm"><a href="https://github.com/jR4dh3y/BoxBox/releases" class="text-text-secondary hover:text-white hover:underline">Standalone server binaries</a><a href="/docs/release/" class="text-accent hover:underline">Release & upgrade notes</a></div>
        <p class="mt-6 text-sm leading-relaxed text-text-muted">Server binaries do not include the desktop window or native file-manager integration. Configure credentials and mounted folders before starting.</p>
      </section>
    </div>
    <p class="mt-8 leading-relaxed text-text-secondary">Already self-hosting? Update the server, get a code from <strong class="text-text-primary">Settings → Account</strong>, and add it under <strong class="text-text-primary">Settings → Connections</strong> on desktop.</p>
  </main>
  <SiteFooter />
</Layout>

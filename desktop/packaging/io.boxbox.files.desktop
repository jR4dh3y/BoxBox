[Desktop Entry]
Type=Application
Version=1.5
Name=BoxBox Files
GenericName=File Manager
Comment=Browse folders and manage files
Exec=@EXEC@ %U
Icon=io.boxbox.files
Terminal=false
Categories=Utility;FileManager;
Keywords=files;folders;browser;manager;
MimeType=inode/directory;x-scheme-handler/file;
StartupNotify=true
StartupWMClass=boxbox-gpui

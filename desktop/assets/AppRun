#!/bin/sh
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# Forward before copying the read-only runtime when this user already has an instance.
# The Bun launcher validates socket ownership and the fixed request protocol.
instance_root=${XDG_RUNTIME_DIR:-/tmp}/boxbox-desktop-$(id -u)
if [ -S "$instance_root/boxbox-desktop.sock" ] &&
   [ -x "$appdir/BoxBox/bin/bun" ] &&
   [ -f "$appdir/BoxBox/Resources/boxbox-launcher.js" ]; then
  handoff=0
  BOXBOX_DESKTOP_HANDOFF_ONLY=1 "$appdir/BoxBox/bin/bun" \
    "$appdir/BoxBox/Resources/boxbox-launcher.js" "$@" || handoff=$?
  case "$handoff" in
    0) exit 0 ;;
    3) ;; # The instance closed during the handoff; launch normally.
    *) exit "$handoff" ;;
  esac
fi
# CEF startup settings are mutable, while the mounted AppImage is read-only.
runtime=$(mktemp -d "${TMPDIR:-/tmp}/boxbox-appimage.XXXXXXXX")
trap 'rm -rf -- "$runtime"' EXIT
cp -a --reflink=auto "$appdir/BoxBox" "$runtime/BoxBox"
chmod -R u+w "$runtime/BoxBox"
"$runtime/BoxBox/bin/launcher" "$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null || true' INT TERM
status=0
wait "$child" || status=$?
# A trapped signal interrupts wait; keep the runtime until the launcher exits.
if kill -0 "$child" 2>/dev/null; then
  wait "$child" || status=$?
fi
exit "$status"
